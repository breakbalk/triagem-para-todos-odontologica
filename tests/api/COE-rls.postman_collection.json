                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/triagens?id_triagem=eq.00000000-0000-0000-0000-000000000000"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"servico\": \"x\"}",
              "options": {
