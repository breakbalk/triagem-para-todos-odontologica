    {
      "name": "B. usuario comum (JWT) - opcional",
      "item": [
        {
          "name": "8. usuário comum: listar triagens de outros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userJwt}}"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/triagens?select=id_triagem&usuario_id=neq.{{userId}}"
            },
            "description": "Só rode se tiver um JWT do Supabase Auth em userJwt. Esperado: 200 com [] (RLS filtra) ou 401/403."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200/401/403 (bloqueado)', function () { pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]); });",
                  "pm.test('nenhuma linha vazou', function () { var t = pm.response.text(); pm.expect(t).to.not.include('@'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9. usuário comum: apagar triagem",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "apikey",
