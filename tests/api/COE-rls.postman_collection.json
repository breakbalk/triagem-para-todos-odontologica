{
  "info": {
    "name": "COE - RLS (Card 2.1)",
    "description": "Valida o bloqueio de anon e de usuario comum. Todos os PATCH/DELETE usam um UUID zerado: nenhuma linha real e afetada. Variaveis: supabaseUrl, anonKey (publishable), backendUrl; opcionais userJwt, userId, tokenPaciente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "A. anon (sem login) na API do Supabase",
      "item": [
        {
          "name": "1. anon: listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/usuarios?select=id_usuario,email&limit=1"
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401/403 (bloqueado)', function () { pm.expect(pm.response.code).to.be.oneOf([401, 403]); });",
                  "pm.test('nenhuma linha vazou', function () { var t = pm.response.text(); pm.expect(t).to.not.include('@'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. anon: listar a fila geral (triagens)",
          "request": {
            "method": "GET",
