        {
          "name": "5. anon: criar triagem",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/triagens"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"usuario_id\": \"00000000-0000-0000-0000-000000000000\", \"servico\": \"protese\", \"periodo\": \"noturno\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": ""
          },
          "event": [
            {
