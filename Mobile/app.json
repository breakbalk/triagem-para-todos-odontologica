{
  "expo": {
    "name": "COE Triagem",
    "slug": "coe-triagem",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#353375"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "br.unievangelica.coe.triagem"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
