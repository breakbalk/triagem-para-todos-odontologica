# Copie para .env na MESMA pasta (Web/backend). Não commite o .env.

COE_STORAGE=supabase

# Project Settings → API → Project URL (https://REF.supabase.co)
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# API → chave SECRET / service_role (obrigatória no Flask). A anon NÃO funciona: o RLS bloqueia (Card 2.1).
SUPABASE_KEY=cole_a_chave_aqui

# API → chave publishable / anon. Só para scripts/validar_rls.py e a coleção do Postman (Card 2.1). Nunca no backend.
SUPABASE_ANON_KEY=cole_a_chave_publishable_aqui

COE_ADMIN_EMAIL=admin@coe.unievangelica.edu.br
COE_ADMIN_PASSWORD=Admin@coe2026

# Chave de assinatura da sessão do Flask (troque em produção)
FLASK_SECRET_KEY=troque-por-um-valor-aleatorio

# E-mails (separados por vírgula) com acesso à fila da recepção, além do admin (Card 2.2)
COE_SECRETARIA_EMAILS=

# Senha das contas da massa sintética (scripts/gerar_massa.py). Vazio = senha aleatória a cada carga (Card 1.3)
MASSA_SENHA=
